        "content_hash": "94a76d110298b93ffcd808210d1b7700bf463ed764436615bbecd2fd1db6eb4d",
        "content": "function browserCliUsage(): string {\n  return [\n    \"Usage:\",\n    \"  anvil browser install --host codex [--corporate-ca <pem>] [--corporate-ca-keychain-label <label>] [--corporate-ca-keychain <path>] [--json]\",\n    \"  anvil browser status [--json]\",\n    \"  anvil browser doctor [--json]\",\n    \"  anvil browser mcp serve --network-mode local|corporate\",\n    \"  anvil browser upgrade --image <digest-pinned-ref> [--json]\",\n    \"  anvil browser uninstall --host codex [--keep-images] [--json]\",\n  ].join(\"\\n\");\n}",
        "source_ref": "eyJlbmQiOjMxODUsImZpbGUiOiJzcmMvYnJvd3Nlci9jbGkudHMiLCJoYXNoIjoiOTRhNzZkMTEwMjk4YjkzZmZjZDgwODIxMGQxYjc3MDBiZjQ2M2VkNzY0NDM2NjE1YmJlY2QyZmQxZGI2ZWI0ZCIsIm9mZnNldCI6MjY3NiwicmVwbyI6Ii9wcml2YXRlL3RtcC9hbnZpbC1zb3VyY2UtdGFza3MtMjAyNjA5MTQvdDI0Iiwic3RhcnQiOjI2NzYsInYiOjF9"
      },
