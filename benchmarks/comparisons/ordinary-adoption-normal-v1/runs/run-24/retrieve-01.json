        "end_line": 1401,
        "content_hash": "055371e87a490edd78d9c1c46aec3202a249372022d63cb1f252bc60f91991dc",
        "content": "async function main(): Promise<void> {\n  if (command.length === 0 || command[0] === \"--help\" || command[0] === \"help\") {\n    process.stdout.write(`${usage()}\\n`);\n    return;\n  }\n\n  if (command[0] === \"manifest\") {\n    const { runManifestCli } = await import(\"./manifest.ts\");\n    await runManifestCli(command.slice(1));\n    return;\n  }\n\n  if (\n    command[0] === \"codex\" &&\n    (command[1] === \"context-hook\" || command[1] === \"session-start-hook\")\n  ) {\n    await runContextHook();\n    return;\n  }\n\n  if (command[0] === \"continuity\" && command[1] === \"read\") {\n    await continuityRead(command.slice(2));\n    return;\n  }\n\n  if (command[0] === \"work-context\" && command[1] === \"read\") {\n    await workContextRead(command.slice(2));\n    return;\n  }\n\n",
        "source_ref": "eyJlbmQiOjUzNjE2LCJmaWxlIjoiYmluL2FudmlsLnRzIiwiaGFzaCI6IjA1NTM3MWU4N2E0OTBlZGQ3OGQ5YzFjNDZhZWMzMjAyYTI0OTM3MjAyMmQ2M2NiMWYyNTJiYzYwZjkxOTkxZGMiLCJvZmZzZXQiOjUyODY2LCJyZXBvIjoiL3ByaXZhdGUvdG1wL2FudmlsLXNvdXJjZS10YXNrcy0yMDI2MDkxNC90MjQiLCJzdGFydCI6NTI4NjYsInYiOjF9"
