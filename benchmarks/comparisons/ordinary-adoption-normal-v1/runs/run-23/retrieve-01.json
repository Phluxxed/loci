        "source_ref": "eyJlbmQiOjEzNzksImZpbGUiOiJzcmMvdG9vbC1yZXN1bHRzL3NlcnZpY2UudHMiLCJoYXNoIjoiZWM3ZWU0MDcxZDlhZTRlMThhMjdjNWVlNjRjM2EzNTE1OWQ3ZTJiYmYwMDYwOWM1ZThkMzJhYjdjMWJkMWE2ZSIsIm9mZnNldCI6MTM1MiwicmVwbyI6Ii9wcml2YXRlL3RtcC9hbnZpbC1zb3VyY2UtdGFza3MtMjAyNjA5MTQvdDIzIiwic3RhcnQiOjEzNTIsInYiOjF9"
