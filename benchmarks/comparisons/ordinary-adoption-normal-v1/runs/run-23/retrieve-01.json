        "content_hash": "ec7ee4071d9ae4e18a27c5ee64c3a35159d7e2bbf00609c5e8d32ab7c1bd1a6e",
        "content": "async function captureCommandResult(options: CaptureCommandResultOptions): Promise<ToolResultReceipt> {\n  const clock = options.now ?? nowIso;\n  const binding = validateBinding(options.binding, clock);\n  const producer = validateProducer(options.producer);\n  const createdAt = clock();\n  const createdAtMs = Date.parse(createdAt);\n  if (!Number.isFinite(createdAtMs)) {\n    throw new ToolResultError(\"TOOL_RESULT_INVALID_REQUEST\", \"now must return an ISO date-time\");\n  }\n  const expiresAt = new Date(createdAtMs + RETENTION_MS).toISOString();\n  const paths = await prepareStore(options.stateRoot);\n  const temporaryDirectory = join(paths.temporary, `.capture-${randomUUID()}`);\n  await mkdir(temporaryDirectory, { mode: 0o700 });\n",
        "source_ref": "eyJlbmQiOjEzOTg4LCJmaWxlIjoic3JjL3Rvb2wtcmVzdWx0cy9zZXJ2aWNlLnRzIiwiaGFzaCI6ImVjN2VlNDA3MWQ5YWU0ZTE4YTI3YzVlZTY0YzNhMzUxNTlkN2UyYmJmMDA2MDljNWU4ZDMyYWI3YzFiZDFhNmUiLCJvZmZzZXQiOjEzMjU3LCJyZXBvIjoiL3ByaXZhdGUvdG1wL2FudmlsLXNvdXJjZS10YXNrcy0yMDI2MDkxNC90MjMiLCJzdGFydCI6MTMyNTcsInYiOjF9"
