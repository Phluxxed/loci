          "start_byte": 1118,
          "start_line": 35
        },
        {
          "content": "function compilerHasUnavailableEvidence(diagnostics: BrainRetrievalResult[\"diagnostics\"]): boolean {\n  return diagnostics.some(({ code }) =>\n    [\"SOURCE_PATH_INVALID\", \"SOURCE_NOT_FOUND\", \"SOURCE_NOT_TEXT\", \"PROVIDER_FAILED\"].includes(code) ||\n    (code.startsWith(\"LOCI_\") &&\n      /(?:FAILED|TIMEOUT|UNAVAILABLE|CONFIG_MISSING|NOT_INDEXED|RESULT_INVALID|RESULT_OUT_OF_SCOPE)$/.test(code)),\n  );\n}",
          "content_hash": "cb58c97ad2e8c247aca183710b6e280312221f187105b610226200134f6efabd",
          "end_byte": 1655,
          "end_line": 32,
