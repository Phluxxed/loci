        {
          "content": "{\n  \"name\": \"anvil-redux\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.18.0\"\n  },\n  \"bin\": {\n    \"anvil\": \"./bin/anvil.ts\",\n    \"manifest\": \"./bin/manifest.ts\",\n    \"brain\": \"./bin/brain.ts\",\n    \"anvil-measurements\": \"./bin/anvil-measurements.ts\"\n  },\n  \"scripts\": {\n    \"eval:brain-context\": \"node scripts/evaluate-brain-context.ts\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"npm run typecheck && node --test --test-concurrency=1 test/*.test.ts\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^25.9.1\",\n    \"js-tiktoken\": \"1.0.21\",\n    \"typescript\": \"^6.0.3\"\n  },\n  \"dependencies\": {\n    \"@modelcontextprotocol/client\": \"^2.0.0\",\n    \"@modelcontextprotocol/server\": \"^2.0.0\",\n    \"zod\": \"^4.4.3\"\n  }\n}\n",
