          "source_ref": "sr1_erjshuy4enf4y4j6d4t3o5biju",
          "start_byte": 3020,
          "start_line": 119
        },
        {
          "content": "export function renderCompilerPromptEvidenceContext(retrieval: BrainRetrievalResult): PromptBrainContextRender {\n",
