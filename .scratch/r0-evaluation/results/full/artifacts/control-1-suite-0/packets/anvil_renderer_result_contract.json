          "end_byte": 3050,
          "end_line": 119,
          "file": "src/brain-context/retrieve.ts",
          "id": 5,
          "source_ref": "sr1_aszuz36ce47aco4bujmdivmaea",
          "start_byte": 3013,
          "start_line": 119
        },
        {
          "content": "{\n  \"name\": \"anvil-redux\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.18.0\"\n  },\n  \"bin\": {\n    \"anvil\": \"./bin/anvil.ts\",\n    \"manifest\": \"./bin/manifest.ts\",\n    \"brain\": \"./bin/brain.ts\",\n    \"anvil-measurements\": \"./bin/anvil-measurements.ts\"\n  },\n  \"scripts\": {\n    \"eval:brain-context\": \"node scripts/evaluate-brain-context.ts\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"npm run typecheck && node --test --test-concurrency=1 test/*.test.ts\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^25.9.1\",\n    \"js-tiktoken\": \"1.0.21\",\n    \"typescript\": \"^6.0.3\"\n  },\n  \"dependencies\": {\n    \"@modelcontextprotocol/client\": \"^2.0.0\",\n    \"@modelcontextprotocol/server\": \"^2.0.0\",\n    \"zod\": \"^4.4.3\"\n  }\n}\n",
          "content_hash": "def1d66868a09fb9ddc183d8e110665c680a49fe14fe60a15d3d3f616ec41bd6",
          "end_byte": 759,
          "end_line": 30,
          "file": "package.json",
          "id": 6,
          "source_ref": "sr1_s2gsrbfpuckmyf2wzowg2pulsm",
          "start_byte": 0,
          "start_line": 1
        },
        {
          "content": "{\n  \"compilerOptions\": {\n    \"allowImportingTsExtensions\": true,\n    \"erasableSyntaxOnly\": true,\n    \"jsx\": \"react-jsx\",\n    \"lib\": [\"ESNext\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"nodenext\",\n    \"noEmit\": true,\n    \"strict\": true,\n    \"target\": \"esnext\",\n    \"types\": [\"node\"],\n    \"verbatimModuleSyntax\": true\n  },\n  \"include\": [\"bin/**/*.ts\", \"scripts/**/*.ts\", \"src/**/*.ts\", \"src/**/*.tsx\", \"test/**/*.ts\"]\n}\n",
          "content_hash": "3e7675116d9906f30a143ea8552b27c323a594da8c5c2d1984cfc76b1ff47ffe",
          "end_byte": 415,
          "end_line": 15,
