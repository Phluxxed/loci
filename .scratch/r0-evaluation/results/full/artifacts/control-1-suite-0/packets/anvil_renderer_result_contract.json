          "start_byte": 4853,
          "start_line": 96
        },
        {
          "content": "import type { BrainCompiledEvidence, BrainRetrievalResult } from \"./retrieve.ts\";\n",
          "content_hash": "cb58c97ad2e8c247aca183710b6e280312221f187105b610226200134f6efabd",
