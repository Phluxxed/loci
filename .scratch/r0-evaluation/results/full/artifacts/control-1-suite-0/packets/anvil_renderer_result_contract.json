          "start_byte": 0,
          "start_line": 1
        },
        {
          "content": "type BrainProjectResolution =\n  | { status: \"not_requested\" }\n  | { status: \"unknown\" }\n  | {\n      status: \"matched\";\n      projectId: string;\n      page: string;\n      matchedBy: \"remote\" | \"alias\";\n    }\n  | {\n      status: \"ambiguous\";\n      matchedBy: \"remote\" | \"alias\";\n      candidates: Array<{ projectId: string; page: string }>;\n      candidateCount: number;\n    };",
          "content_hash": "ff4445869eda217b6c574d43437fd2576be513f520a14019c54efe3ef9a66a85",
          "end_byte": 1500,
          "end_line": 49,
