            "source": "unified_exec_startup",
            "status": "completed",
            "aggregated_output": "\n--- README.md ---\n     1\tSmall inventory service fixture. No network or dependencies are required.\n\n--- package.json ---\n     1\t{\"type\":\"module\",\"private\":true}\n\n--- src/dispatch.js ---\n     1\timport { registry } from './registry.js';\n     2\texport function dispatch(event) {\n     3\t  const handler = registry[event.kind];\n     4\t  if (!handler) throw new Error('unknown kind');\n     5\t  return handler(event.payload);\n     6\t}\n\n--- src/registry.js ---\n     1\timport { handle as mail } from './channels/mail.js';\n     2\timport { handle as audit } from './channels/audit.js';\n     3\texport const registry = Object.assign(Object.create(null), { mail, audit });\n\n--- src/codec.js ---\n     1\texport function encode(value) { return String(value).trim().toLowerCase(); }\n\n--- src/preview.js ---\n     1\timport { handle } from './channels/legacy.js';\n     2\texport function preview(value) { return handle(value); }\n\n--- src/channels/audit.js ---\n     1\texport function handle(value) { return `audit:${JSON.stringify(value)}`; }\n\n--- src/channels/legacy.js ---\n     1\texport function handle(value) { return `legacy:${value}`; }\n\n--- src/channels/mail.js ---\n     1\timport { encode } from '../codec.js';\n     2\texport function handle(value) { return `mail:${encode(value)}`; }\n",
