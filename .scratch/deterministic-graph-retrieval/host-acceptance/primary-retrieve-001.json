          "content_hash": "b96c4dbf5a327746eb408b7c28026f2b3f86f7bc7fa179ddaa1ecd3401f5c0da",
          "content": "async def retrieve():\n        env = os.environ.copy()\n        env[\"LOCI_BASE_DIR\"] = str(cache_dir)\n        env[\"LOCI_STORE_NAMESPACE\"] = \"test\"\n        env[\"PYTHONPATH\"] = str(Path.cwd() / \"src\")\n        params = StdioServerParameters(\n            command=sys.executable,\n            args=[\"-m\", \"loci.mcp_server\"],\n            env=env,\n            cwd=Path.cwd(),\n        )\n        async with Client(stdio_client(params)) as session:\n            for name, body in (\n                (\"First Fixture\", \"First section body.\"),\n                (\"Second Fixture\", \"Second section body.\"),\n            ):\n                # The first search builds the index; the second uses it warm.\n                search = await session.call_tool(\n                    \"loci_search\", arguments={\"repo\": str(repo), \"query\": name}\n                )\n                assert not search.is_error\n                result = search.structured_content\n                selected = next(s for s in result[\"symbols\"] if s[\"name\"] == name)\n",
          "source_ref": "eyJlbmQiOjI0NzcxLCJmaWxlIjoidGVzdHMvdGVzdF9tY3Bfc2VydmVyLnB5IiwiaGFzaCI6ImI5NmM0ZGJmNWEzMjc3NDZlYjQwOGI3YzI4MDI2ZjJiM2Y4NmY3YmM3ZmExNzlkZGFhMWVjZDM0MDFmNWMwZGEiLCJvZmZzZXQiOjIzNzY3LCJyZXBvIjoiL1VzZXJzL2JydW1tZXJ2L2xvY2kiLCJzdGFydCI6MjM3NjcsInYiOjF9"
