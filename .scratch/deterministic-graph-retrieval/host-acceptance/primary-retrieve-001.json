          "content_hash": "6396c900713b44ffbbd9dfa186720a94594b36ad56375fc4746636acc679e13f",
          "content": "def retrieve_context(\n    repo: Path,\n    store: IndexStore,\n    nodes: dict[str, dict],\n    state: GraphIndexState,\n    query: str = \"\",\n    *,\n    seed_ids: list[str] | None = None,\n    coverage: str = \"unknown\",\n) -> dict:\n    \"\"\"Return normal-graph-v1 context without caller-selected graph controls.\"\"\"\n    seeds = _validate_request(query, seed_ids)\n    source = RetrievalSource(repo, store, nodes, state)\n    anchors, selection, matching, lookup, selection_omissions = _select_anchors(\n        nodes, source, query, seeds,\n    )\n    anchor_values = [\n        {\n            \"node_id\": anchor.node_id,\n            \"score\": anchor.score,\n            \"matched_terms\": list(anchor.matched_terms),\n            \"match_scope\": list(anchor.match_scope),\n        }\n        for anchor in anchors\n    ]\n    packer = RetrievalPacker(\n        repo,\n        snapshot=snapshot_id(state, source.file_hashes),\n        selection=selection,\n        scope={\n            \"source\": \"indexed_supported_source\",\n",
          "source_ref": "eyJlbmQiOjI2NzQsImZpbGUiOiJzcmMvbG9jaS9yZXRyaWV2YWwucHkiLCJoYXNoIjoiNjM5NmM5MDA3MTNiNDRmZmJiZDlkZmExODY3MjBhOTQ1OTRiMzZhZDU2Mzc1ZmM0NzQ2NjM2YWNjNjc5ZTEzZiIsIm9mZnNldCI6MTY4MiwicmVwbyI6Ii9Vc2Vycy9icnVtbWVydi9sb2NpIiwic3RhcnQiOjE2ODIsInYiOjF9"
        },
        {
          "id": 2,
          "file": "src/loci/service.py",
          "start_byte": 40432,
          "end_byte": 41197,
          "start_line": 1181,
          "end_line": 1197,
          "content_hash": "0ad5cd7fdad07e1e4595267112eec67b2875ad9138c1ca9766fb7082c22f77af",
          "content": "def retrieve(\n    repo: str | Path, query: str = \"\", *, seed_ids: list[str] | None = None,\n    ensure_fresh: bool = False,\n) -> dict[str, Any]:\n    \"\"\"Return normal source context through the fixed graph policy.\"\"\"\n    from loci.retrieval import retrieve_context\n\n    repo_path = Path(repo).resolve()\n    store, nodes, state = _load_graph_context(repo_path, ensure_fresh=ensure_fresh)\n    coverage = query_coverage_from_index(\n        _load_required_index(store, repo_path), \"indexed_symbols\",\n    )\n    try:\n        return retrieve_context(repo_path, store, nodes, state, query,\n                                seed_ids=seed_ids, coverage=coverage[\"state\"])\n    except GraphContractError as exc:\n        raise LociError(exc.code, exc.message, exc.details) from exc",
          "source_ref": "eyJlbmQiOjQxMTk3LCJmaWxlIjoic3JjL2xvY2kvc2VydmljZS5weSIsImhhc2giOiIwYWQ1Y2Q3ZmRhZDA3ZTFlNDU5NTI2NzExMmVlYzY3YjI4NzVhZDkxMzhjMWNhOTc2NmZiNzA4MmMyMmY3N2FmIiwib2Zmc2V0Ijo0MDQzMiwicmVwbyI6Ii9Vc2Vycy9icnVtbWVydi9sb2NpIiwic3RhcnQiOjQwNDMyLCJ2IjoxfQ"
