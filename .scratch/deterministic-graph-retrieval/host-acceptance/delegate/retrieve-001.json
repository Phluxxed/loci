          "start_line": 97,
          "end_line": 110,
          "content_hash": "79857849ec35028c0e06477f0fcb65ae265c87d124338f53fececc2dff392307",
          "content": "def test_mcp_binding_ignores_only_safe_catalog_advisory_lock(tmp_path: Path) -> None:\n    root = tmp_path / \"store\"\n    root.mkdir(mode=0o700)\n    assert RepositoryCatalog(root).list_entries() == []\n    lock = root / MUTATION_LOCK_FILE_NAME\n    assert lock.is_file() and lock.stat().st_size == 0\n\n    binding = bind_mcp_store({\n        \"LOCI_BASE_DIR\": str(root),\n        \"LOCI_STORE_NAMESPACE\": \"pytest\",\n    })\n\n    assert binding.base_dir == root\n    assert (root / \".loci-store.json\").exists()",
          "source_ref": "eyJlbmQiOjMxNzUsImZpbGUiOiJ0ZXN0cy90ZXN0X3N0b3JlX2lzb2xhdGlvbi5weSIsImhhc2giOiI3OTg1Nzg0OWVjMzUwMjhjMGUwNjQ3N2YwZmNiNjVhZTI2NWM4N2QxMjQzMzhmNTNmZWNlY2MyZGZmMzkyMzA3Iiwib2Zmc2V0IjoyNjc4LCJyZXBvIjoiL1VzZXJzL2JydW1tZXJ2L2xvY2kiLCJzdGFydCI6MjY3OCwidiI6MX0"
