          "content_hash": "b96c4dbf5a327746eb408b7c28026f2b3f86f7bc7fa179ddaa1ecd3401f5c0da",
          "content": "def test_mcp_process_requires_explicit_store_configuration(tmp_path: Path):\n    env = os.environ.copy()\n    env.pop(\"LOCI_BASE_DIR\", None)\n    env.pop(\"LOCI_STORE_NAMESPACE\", None)\n\n    result = subprocess.run(\n        [sys.executable, \"-m\", \"loci.mcp_server\"],\n        capture_output=True,\n        text=True,\n        env=env,\n        timeout=5,\n    )\n\n    assert result.returncode == 78\n    error = _stderr_json_records(result.stderr)[-1][\"error\"]\n    assert error[\"code\"] == \"MCP_STORE_CONFIG_MISSING\"\n    assert error[\"details\"][\"missing\"] == [\n        \"LOCI_BASE_DIR\",\n        \"LOCI_STORE_NAMESPACE\",\n    ]",
