          "start_line": 57,
          "end_line": 78,
          "content_hash": "79857849ec35028c0e06477f0fcb65ae265c87d124338f53fececc2dff392307",
          "content": "def test_mcp_binding_uses_inherited_suite_store_boundary() -> None:\n    root = _suite_store_root()\n    assert RepositoryCatalog(root).list_entries() == []\n    script = (\n        \"import json; \"\n        \"from loci.storage.store_identity import bind_mcp_store; \"\n        \"print(json.dumps(bind_mcp_store().to_dict(), sort_keys=True))\"\n    )\n\n    result = subprocess.run(\n        [sys.executable, \"-c\", script],\n        check=False,\n        capture_output=True,\n        text=True,\n        env=os.environ.copy(),\n    )\n\n    assert result.returncode == 0, result.stderr\n    binding = json.loads(result.stdout)\n    assert binding[\"base_dir\"] == str(root)\n    assert binding[\"namespace\"] == \"pytest\"\n    assert (root / \".loci-store.json\").exists()",
          "source_ref": "eyJlbmQiOjIyMzQsImZpbGUiOiJ0ZXN0cy90ZXN0X3N0b3JlX2lzb2xhdGlvbi5weSIsImhhc2giOiI3OTg1Nzg0OWVjMzUwMjhjMGUwNjQ3N2YwZmNiNjVhZTI2NWM4N2QxMjQzMzhmNTNmZWNlY2MyZGZmMzkyMzA3Iiwib2Zmc2V0IjoxNDk0LCJyZXBvIjoiL1VzZXJzL2JydW1tZXJ2L2xvY2kiLCJzdGFydCI6MTQ5NCwidiI6MX0"
        },
        {
