          "source_ref": "eyJlbmQiOjc2NCwiZmlsZSI6InRlc3RzL3Rlc3RfbWNwX3NlcnZlci5weSIsImhhc2giOiJiOTZjNGRiZjVhMzI3NzQ2ZWI0MDhiN2MyODAyNmYyYjNmODZmN2JjN2ZhMTc5ZGRhYTFlY2QzNDAxZjVjMGRhIiwib2Zmc2V0Ijo2MjQsInJlcG8iOiIvVXNlcnMvYnJ1bW1lcnYvbG9jaSIsInN0YXJ0Ijo2MjQsInYiOjF9"
