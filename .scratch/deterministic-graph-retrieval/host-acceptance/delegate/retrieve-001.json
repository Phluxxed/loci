          "content_hash": "b96c4dbf5a327746eb408b7c28026f2b3f86f7bc7fa179ddaa1ecd3401f5c0da",
          "content": "@pytest.mark.parametrize(\"entrypoint\", [\"outline\", \"file\", \"grep\", \"graph_health\"])\ndef test_mcp_retrieval_entrypoints_cold_start_on_empty_stores(\n    tmp_path: Path,\n    entrypoint: str,\n):\n    repo = tmp_path / \"repo\"\n    repo.mkdir()\n    (repo / \"fixture.py\").write_text(\n        \"def cold_entrypoint_fixture():\\n    return 1\\n\",\n        encoding=\"utf-8\",\n    )\n    cache_dir = tmp_path / \".codeindex\"\n\n    call_arguments: dict[str, Any]\n    if entrypoint == \"outline\":\n        tool = \"loci_outline\"\n        call_arguments = {\"repo\": str(repo)}\n    elif entrypoint == \"file\":\n        tool = \"loci_file\"\n        call_arguments = {\n            \"repo\": str(repo),\n            \"file_path\": \"fixture.py\",\n            \"start_line\": 1,\n            \"end_line\": 2,\n        }\n    elif entrypoint == \"grep\":\n        tool = \"loci_grep\"\n        call_arguments = {\"repo\": str(repo), \"pattern\": \"cold_entrypoint_fixture\"}\n    else:\n        tool = \"loci_graph_health\"\n        call_arguments = {\"repo\": str(repo)}\n\n",
          "source_ref": "eyJlbmQiOjI2NTQ3LCJmaWxlIjoidGVzdHMvdGVzdF9tY3Bfc2VydmVyLnB5IiwiaGFzaCI6ImI5NmM0ZGJmNWEzMjc3NDZlYjQwOGI3YzI4MDI2ZjJiM2Y4NmY3YmM3ZmExNzlkZGFhMWVjZDM0MDFmNWMwZGEiLCJvZmZzZXQiOjI1NTQ2LCJyZXBvIjoiL1VzZXJzL2JydW1tZXJ2L2xvY2kiLCJzdGFydCI6MjU1NDYsInYiOjF9"
        },
        {
          "id": 2,
          "file": "tests/test_store_isolation.py",
          "start_byte": 1494,
