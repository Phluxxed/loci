          "content": "function truncateText(text: string): string {\n  const normalized = String(text).replace(/[\\r\\n\\t]+/g, \" \").replace(/ +/g, \" \").trim();\n  if (normalized.length <= MAX_ITEM_CHARS) return normalized;\n  return `${normalized.slice(0, Math.max(0, MAX_ITEM_CHARS - 3)).trimEnd()}...`;\n}",
          "source_ref": "eyJlbmQiOjUyNSwiZmlsZSI6InNyYy9jb250aW51aXR5L3JlbmRlci50cyIsImhhc2giOiI3MDk3NDM5NDg2OTViZDJkZjEwMzQxMDYzOGI2MGQxZTUwOGExNzE3NDkyNzJmZmExMGI3ZjA5ODdkOTYzM2JkIiwib2Zmc2V0IjoyNDYsInJlcG8iOiIvcHJpdmF0ZS90bXAvYW52aWwtc291cmNlLXRhc2tzLTIwMjYwOTE0L3QyMyIsInN0YXJ0IjoyNDYsInYiOjF9"
