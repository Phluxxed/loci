u6kz56rmhqsdv34w2wcku"},{"id":4,"file":"src/continuity/render.ts","start_byte":168,"end_byte":245,"start_line":10,"end_line":10,"content_hash":"709743948695bd2df103410638b60d1e508a171749272ffa10b7f0987d9633bd","content":"import type { ActiveTask, CurrentFrame, ContinuityItem } from \"./schema.ts\";\n","source_ref":"sr1_5nds6l7ito6yzqnianb7odhifu"},{"id":5,"file":"src/continuity/schema.ts","start_byte":1585,"end_byte":1644,"start_line":50,"end_line":50,"content_hash":"ae14e1a8802dec042c45d077c213fa0df8a0e1ae873901a5bb7a3eaf3a89ba5a","content":"export type ActiveTask = z.infer<typeof activeTaskSchema>;\n","source_ref":"sr1_dm5sn2qijsubluwr2xwfg4hqxe"},{"id":6,"file":"package.json","start_byte":0,"end_byte":759,"start_line":1,"end_line":30,"content_hash":"def1d66868a09fb9ddc183d8e110665c680a49fe14fe60a15d3d3f616ec41bd6","content":"{\n  \"name\": \"anvil-redux\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22.18.0\"\n  },\n  \"bin\": {\n    \"anvil\": \"./bin/anvil.ts\",\n    \"manifest\": \"./bin/manifest.ts\",\n    \"brain\": \"./bin/brain.ts\",\n    \"anvil-measurements\": \"./bin/anvil-measurements.ts\"\n  },\n  \"scripts\": {\n    \"eval:brain-context\": \"node scripts/evaluate-brain-context.ts\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"npm run typecheck && node --test --test-concurrency=1 test/*.test.ts\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^25.9.1\",\n    \"js-tiktoken\": \"1.0.21\",\n    \"typescript\": \"^6.0.3\"\n  },\n  \"dependencies\": {\n    \"@modelcontextprotocol/client\": \"^2.0.0\",\n    \"@modelcontextprotocol/server\": \"^2.0.0\",\n    \"zod\": \"^4.4.3\"\n  }\n}\n","source_ref":"sr1_jsyowci77n2g3d7cyccksrown4"},{"id":7,"file":"tsconfig.json","start_byte":0,"end_byte":415,"start_line":1,"end_line":15,"content_hash":"3e7675116d9906f30a143ea8552b27c323a594da8c5c2d1984cfc76b1ff47ffe","content":"{\n  \"compilerOptions\": {\n    \"allowImportingTsExtensions\": true,\n    \"erasableSyntaxOnly\": true,\n    \"jsx\": \"react-jsx\",\n    \"lib\": [\"ESNext\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"nodenext\",\n    \"noEmit\": true,\n    \"strict\": true,\n    \"target\": \"esnext\",\n    \"types\": [\"node\"],\n    \"verbatimModuleSyntax\": true\n  },\n  \"include\": [\"bin/**/*.ts\", \"scripts/**/*.ts\", \"src/**/*.ts\", \"src/**/*.tsx\", \"test/**/*.ts\"]\n}\n","source_ref":"sr1_ciytkskirwwtrmbv5s4wbf4qpy"},{"id":8,"file":"src/continuity/render.ts","start_byte":246,"end_byte":525,"start_line":12,"end_line":16,"content_hash":"709743948695bd2df103410638b60d1e508a171749272ffa10b7f0987d9633bd","content":"function truncateText(text: string): string {\n  const normalized = String(text).replace(/[\\r\\n\\t]+/g, \" \").replace(/ +/g, \" \").trim();\n  if (normalized.length <= MAX_ITEM_CHARS) return normalized;\n  return `${normalized.slice(0, Math.max(0, MAX_ITEM_CHARS - 3)).trimEnd()}...`;\n}","source_ref":"sr1_akq5hfjht3lhbizjcabepc6sda"},{"id":9,"file":"src/continuity/render.ts","start_byte":2756,"end_byte":3428,"start_line":77,"end_line":88,"content_hash":"709743948695bd2df103410638b60d1e508a171749272ffa10b7f0987d9633bd","content":"function renderContinuityFrame(frame: CurrentFrame): string {\n  return [\n    \"## Anvil Continuity Frame\",\n    \"\",\n    \"This is workspace continuity, not truth. Current user instruction, current files, command output, tests, and live project evidence override stale continuity.\",\n    \"\",\n    `Workspace: ${frame.workspace.label ?? frame.workspace.key} (${frame.workspace.root})`,\n    `Operating mode: ${truncateText(frame.operating_mode)}`,\n    `Intent: ${truncateText(frame.intent)}`,\n    ...renderActiveTask(frame.active_task),\n    ...renderStringList(\"Quality bar\", frame.quality_bar, MAX_QUALITY_BAR_ITEMS, \"quality bar items\"),\n    ...renderPermissionEnvelope(frame),\n","source_ref":"sr1_lhi3lh4gxa54nejvq5kgxouupy"},{"id":10,"file":"bin/anvil.ts","start_byte":17731,"end_byte":18484,"start_line":481,"end_line":498,"content_hash":"055371e87a490edd78d9c1c46aec3202a249372022d63cb1f252bc60f91991dc","content":"async function runContextHook(): Promise<void> {\n  let input: CodexHookInput = {};\n  const text = await readStdin();\n  if (text.trim().length > 0) {\n    try {\n      input = JSON.parse(text);\n    } catch {\n      input = {};\n    }\n  }\n\n  const cwd = typeof input.cwd === \"string\" && input.cwd.trim().length > 0 ? input.cwd : process.cwd();\n  const hookEventName = input.hook_event_name ?? \"SessionStart\";\n  if (hookEventName === \"PreToolUse\") {\n    if (isDirectCodexContextHookProbe(input.tool_name, input.tool_input)) {\n      const reason =\n        \"HOST_LIFECYCLE_PROBE_BLOCKED: Agent-issued Codex lifecycle-hook probes are forbidden. Use the context injected by the registered host hook.\";\n      process.stderr.write(`[anvil codex hook] ${reason}\\n`);\n","source_ref":"sr1_webu6yqstozhdnwkcy2u6c7qtm"},{"id":11,"file":"bin/anvil.ts","start_byte":26024,"end_byte":26040,"start_line":690,"end_line":690,"content_hash":"055371e87a490edd78d9c1c46aec3202a249372022d63cb1f252bc60f91991dc","content":"renderActiveTask","source_ref":"sr1_uxrf7mt3244vjwsmcuslhzxohu"},{"id":12,"file":"bin/anvil.ts","start_byte":521,"end_byte":798,"start_line":13,"end_line":24,"content_hash":"055371e87a490edd78d9c1c46aec3202a249372022d63cb1f252bc60f91991dc","content":"import {\n  auditContinuityRouting,\n  deriveContinuityPaths,\n  doctorContinuity,\n  gitWorkspaceRef,\n  initWorkspace,\n  readCurrent,\n  renderActiveTask,\n  renderContinuityDoctor,\n  renderContinuityFrame,\n  renderMalformedContinuityDiagnostic,\n} from \"../src/continuity/index.ts\";","source_ref":"sr1_pm4oobu5skmpdievkgkmk344fi"},{"id":13,"file":"src/continuity/index.ts","start_byte":61,"end_byte":90,"start_line":3,"end_line":3,"content_hash":"797e7f0b1a0c0ad03a8e8f68a0ce21dbf9fc92d9109161f3caaa9f42e0dd8791","content":"export * from \"./render.ts\";\n","source_ref":"sr1_nlyt