k-context/index.ts\";\nimport type { WorkContextBinding, WorkContextBindingView } from \"../work-context/index.ts\";\nimport {\n  BrainUsageIdentityError,\n  loadBrainUsageIdentityRegistry,\n  resolveCurrentBrainUsageIdentity,\n  validateBrainUsageIdentity,\n} from \"./identity.ts\";\nimport type {\n  BrainUsageIdentity,\n  BrainUsageIdentityErrorCode,\n  BrainUsageIdentityRegistry,\n} from \"./identity.ts\";\nimport { validateBrainRecallObservation } from \"./recall-observation.ts\";\n","source_ref":"sr1_7jpzcztpp5ef6og2vv65lc3pei"},{"id":4,"file":"src/work-context/binding.ts","start_byte":1977,"end_byte":2052,"start_line":67,"end_line":67,"content_hash":"fcf9ce8fbbefdffcfdbd461a4c5b08e84f7a36220e99aee6dcdd64ad8ce3ca3f","content":"type WorkContextBindingView = z.infer<typeof workContextBindingViewSchema>;","source_ref":"sr1_g3aujwf5mznsil3nsnzxunrssi"},{"id":5,"file":"src/bootstrap/index.ts","start_byte":2724,"end_byte":2746,"start_line":77,"end_line":77,"content_hash":"74c8910221d29b2d5d16a9748148710682e8a2ab6a2b002e151705db31641812","content":"WorkContextBindingView","source_ref":"sr1_2io36gvutp6l7nk6h72sgn62hu"},{"id":6,"file":"src/work-context/index.ts","start_byte":587,"end_byte":795,"start_line":23,"end_line":30,"content_hash":"126125cebca0701b86547926296ff1e46b07fcb826b2a0fc75755b95d57ca6b7","content":"export type {\n  BindWorkContextOptions,\n  RequireWorkContextBindingOptions,\n  SupersedeWorkContextBindingOptions,\n  WorkContextBinding,\n  WorkContextBindingView,\n  WorkContextErrorCode,\n} from \"./binding.ts\";","source_ref":"sr1_zlenkelbmt4p4lza2kbjnpdatu"},{"id":7,"file":"src/work-context/binding.ts","start_byte":1970,"end_byte":2053,"start_line":67,"end_line":67,"content_hash":"fcf9ce8fbbefdffcfdbd461a4c5b08e84f7a36220e99aee6dcdd64ad8ce3ca3f","content":"export type WorkContextBindingView = z.infer<typeof workContextBindingViewSchema>;\n","source_ref":"sr1_xsrlugqccaxhs5gpuulzuhh7fa"},{"id":8,"file":"package.json","start_byte":0,"end_byte":759,"start_