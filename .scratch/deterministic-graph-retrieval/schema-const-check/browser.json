ef":"sr1_ciytkskirwwtrmbv5s4wbf4qpy"},{"id":10,"file":"src/browser/cli.ts","start_byte":2676,"end_byte":3185,"start_line":92,"end_line":102,"content_hash":"94a76d110298b93ffcd808210d1b7700bf463ed764436615bbecd2fd1db6eb4d","content":"function browserCliUsage(): string {\n  return [\n    \"Usage:\",\n    \"  anvil browser install --host codex [--corporate-ca <pem>] [--corporate-ca-keychain-label <label>] [--corporate-ca-keychain <path>] [--json]\",\n    \"  anvil browser status [--json]\",\n    \"  anvil browser doctor [--json]\",\n    \"  anvil browser mcp serve --network-mode local|corporate\",\n    \"  anvil browser upgrade --image <digest-pinned-ref> [--json]\",\n    \"  anvil browser uninstall --host codex [--keep-images] [--json]\",\n  ].join(\"\\n\");\n}","source_ref":"sr1_kpny6ilbhieuvjfictkmhu7enq"},{"id":11,"file":"bin/anvil.ts","start_byte":52866,"end_byte":53616,"start_line":1372,"end_line":1401,"content_hash":"055371e87a490edd78d9c1c46aec3202a249372022d63cb1f252bc60f91991dc","content":"async function main(): Promise<void> {\n  if (command.length === 0 || command[0] === \"--help\" || command[0] === \"help\") {\n    process.stdout.write(`${usage()}\\n`);\n    return;\n  }\n\n  if (command[0] === \"manifest\") {\n    const { runManifestCli } = await import(\"./manifest.ts\");\n    await runManifestCli(command.slice(1));\n    return;\n  }\n\n  if (\n    command[0] === \"codex\" &&\n    (command[1] === \"context-hook\" || command[1] === \"session-start-hook\")\n  ) {\n    await runContextHook();\n    return;\n  }\n\n  if (command[0] === \"continuity\" && command[1] === \"read\") {\n    await continuityRead(command.slice(2));\n    return;\n  }\n\n  if (command[0] === \"work-context\" && command[1] === \"read\") {\n    await workContextRead(command.slice(2));\n    return;\n  }\n\n","source_ref":"sr1_5w7dus6xyb2zs27nji4pscev5e"},{"id":12,"file":"bin/anvil.ts","start_byte":55182,"end_byte":55335,"start_line":1463,"end_line":1466,"content_hash":"055371e87a490edd78d